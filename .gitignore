node_modules/
dist/
data/children/

# Xcode DerivedData と実機ログの置き場（1GB超）。ビルド生成物なので追跡しない。
build/

*.backup.*
.superpowers/

# Audio masters: WAV sources are the uncompressed masters and are NOT shipped
# (Cloudflare Pages has a 25MB/file limit). Only the compressed MP3 is tracked
# and referenced at runtime (main.ts). Keep the .wav locally, out of git.
karate-trainer/public/characters/*.wav

# Local agent/tooling state
.claude/worktrees/
.serena/cache/

# Local env (RevenueCat SDK keys)
*.local

# macOS folder metadata
.DS_Store

# App Store assets: keep the text (listing, notes, slides.json) in git, the big
# images (screenshots, review shots, sources) only on disk — see appstore/README.md
appstore/**/*.png
appstore/**/*.jpg
appstore/**/*.jpeg
appstore/**/*.webp
