{
  "name": "talk-quest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev:server": "tsx watch src/backend/server.ts",
    "dev:game": "vite --config src/game/vite.config.ts",
    "dev:karate": "vite --config karate-trainer/vite.config.ts",
    "build:karate": "vite build --config karate-trainer/vite.config.ts",
    "cap:sync": "npm run build:karate && cap sync ios",
    "cap:open": "cap open ios",
    "ios": "npm run build:karate && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.185.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
