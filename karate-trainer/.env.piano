# アランのピアノ (com.alan.piano): npm run build:piano
VITE_APP_FLAVOR=piano
VITE_APP_NAME=アランのピアノ
# The karate RevenueCat key in .env.local must never reach the piano app — its
# products live under a different bundle id. Put the piano key in
# .env.piano.local (gitignored) once it exists.
VITE_REVENUECAT_API_KEY=
