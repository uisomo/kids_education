# アランのピアノ の test アプリ (com.alan.piano.test): npm run build:piano:test
#
# .env.piano is NOT loaded for this mode — Vite only reads .env.[mode] for the
# one mode it was given — so the piano settings are repeated here.
VITE_APP_FLAVOR=piano
VITE_APP_NAME=アランのピアノ
VITE_TEST_MODE=true
# The karate RevenueCat key in .env.local must never reach a piano build.
VITE_REVENUECAT_API_KEY=
